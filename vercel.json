{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/design-consultant", "destination": "/api/design-consultant" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
